# KIVO environment template. Copy to .env and fill in real values.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Database (server only)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://kivo:change-me@localhost:5432/kivo?schema=public"
# Used by integration tests. The test runner recreates this database.
TEST_DATABASE_URL="postgresql://kivo:change-me@localhost:5432/kivo_test?schema=public"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
# Comma separated list of browser origins allowed to call the API with cookies.
CORS_ORIGIN="http://localhost:5173"
# Set to "true" when the API is served over HTTPS so session cookies get the
# Secure flag. Must be true in production.
COOKIE_SECURE="false"
# Comma separated proxies that may set X-Forwarded-For, e.g. "loopback".
TRUST_PROXY=""

# ---------------------------------------------------------------------------
# Secrets - generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-with-32-bytes-of-random-hex"
CSRF_SECRET="replace-with-32-bytes-of-random-hex"

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# ---------------------------------------------------------------------------
# Frontend (Vite) - web/.env
# ---------------------------------------------------------------------------
# Base URL of the API. Leave as /api when the web app is served behind a proxy
# that forwards /api to the server.
VITE_API_BASE_URL="/api"
